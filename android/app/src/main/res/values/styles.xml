<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!-- Sessio is a light-only design. forceDarkAllowed=false on every theme
         tells Android WebView to never apply force-dark / algorithmic darkening,
         regardless of the user's system dark mode setting. This is the
         permanent fix for the Samsung Internet "Night mode" inversion bug
         that was breaking the page on the TWA. -->

    <!-- Base application theme. -->
    <style name="AppTheme" parent="Theme.AppCompat.Light.DarkActionBar">
        <item name="colorPrimary">@color/colorPrimary</item>
        <item name="colorPrimaryDark">@color/colorPrimaryDark</item>
        <item name="colorAccent">@color/colorAccent</item>
        <item name="android:forceDarkAllowed">false</item>
    </style>

    <!-- Switched parent from Theme.AppCompat.DayNight.NoActionBar to
         Theme.AppCompat.Light.NoActionBar so the theme itself never goes dark. -->
    <style name="AppTheme.NoActionBar" parent="Theme.AppCompat.Light.NoActionBar">
        <item name="windowActionBar">false</item>
        <item name="windowNoTitle">true</item>
        <item name="android:background">@null</item>
        <item name="android:forceDarkAllowed">false</item>
    </style>


    <style name="AppTheme.NoActionBarLaunch" parent="Theme.SplashScreen">
        <item name="android:background">@drawable/splash</item>
        <item name="android:forceDarkAllowed">false</item>
    </style>
</resources>